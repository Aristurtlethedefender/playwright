27:["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Organization\",\"@id\":\"https://barangayos.com/#organization\",\"name\":\"BarangayOS\",\"url\":\"https://barangayos.com\",\"logo\":\"https://barangayos.com/logos/barangayos-icon-512.png\",\"description\":\"BarangayOS is the website and app barangays in the Philippines use to serve residents online: document requests, e-wallet payments, request tracking, QR-verified documents and barangay news.\",\"founder\":{\"@type\":\"Person\",\"name\":\"Pacholo Amit\"},\"parentOrganization\":{\"@type\":\"Organization\",\"name\":\"Zentech Inc.\",\"url\":\"https://zentech.sh\"},\"areaServed\":{\"@type\":\"Country\",\"name\":\"Philippines\"},\"email\":\"hello@zentech.ph\"}"}}]
28:["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebSite\",\"@id\":\"https://barangayos.com/#website\",\"name\":\"BarangayOS\",\"url\":\"https://barangayos.com\",\"inLanguage\":\"en-PH\",\"publisher\":{\"@id\":\"https://barangayos.com/#organization\"}}"}}]
29:["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"WebApplication\",\"name\":\"BarangayOS\",\"url\":\"https://barangayos.com\",\"applicationCategory\":\"GovernmentApplication\",\"operatingSystem\":\"Web\",\"browserRequirements\":\"Requires a modern web browser\",\"description\":\"Request a barangay clearance or certificate from your phone, pay fees with GCash, Maya or GrabPay, and track every step. Find your barangay on BarangayOS.\",\"offers\":{\"@type\":\"Offer\",\"price\":\"0\",\"priceCurrency\":\"PHP\",\"description\":\"No subscription fees for barangays.\"},\"featureList\":[\"Online barangay document requests: clearances, certificates and permits\",\"Fee payments with GCash, Maya or GrabPay\",\"Request tracking with SMS and email updates\",\"QR code verification of released documents\",\"Resident identity verification\",\"Staff dashboard for the barangay hall\",\"Barangay news by app, SMS and email\",\"Walk-in kiosk for the barangay hall\"],\"publisher\":{\"@id\":\"https://barangayos.com/#organization\"}}"}}]
63:Tbc7,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is BarangayOS?","acceptedAnswer":{"@type":"Answer","text":"BarangayOS is a modern digital platform that transforms how barangays serve their communities. It enables residents to request documents, pay fees, and track their requests online, eliminating the need for long queues and manual paperwork at the barangay hall."}},{"@type":"Question","name":"Can I request from my home barangay while I live or work somewhere else?","acceptedAnswer":{"@type":"Answer","text":"Yes. Open your home barangay's portal from anywhere in the Philippines, request and pay online, and follow every step by SMS and email. Once the document is released you can download it as a PDF from the portal, and its QR code lets an employer or agency confirm it is genuine."}},{"@type":"Question","name":"Is BarangayOS really free?","acceptedAnswer":{"@type":"Answer","text":"Yes. BarangayOS is completely free for all barangays. There are no subscription fees, no premium tiers, and no trials that expire. We sustain the platform by collecting a small processing markup on document request payments made through our e-wallet integrations (GCash, Maya, etc.). Barangays and residents never pay for the software itself."}},{"@type":"Question","name":"Which barangays are currently using BarangayOS?","acceptedAnswer":{"@type":"Answer","text":"BarangayOS is being adopted by barangays across the Philippines. You can visit our Barangay Directory to see all currently active barangays on the platform and find yours."}},{"@type":"Question","name":"What documents can I request online?","acceptedAnswer":{"@type":"Answer","text":"You can request a wide range of barangay documents including Barangay Clearances, Certificates of Residency, Certificates of Indigency, Business Permits, and more. Each barangay can configure the types of documents available based on their needs."}},{"@type":"Question","name":"How do I pay for document fees?","acceptedAnswer":{"@type":"Answer","text":"BarangayOS supports multiple e-wallet payment methods including GCash, Maya, GrabPay, and ShopeePay. Simply select your preferred payment method during the document request process and complete the payment from your phone."}},{"@type":"Question","name":"Is my personal information secure?","acceptedAnswer":{"@type":"Answer","text":"Absolutely. BarangayOS uses industry-standard encryption and security practices to protect your data. All personal information is stored securely, and each document includes QR-based verification to prevent tampering and fraud."}},{"@type":"Question","name":"How do I get my barangay on BarangayOS?","acceptedAnswer":{"@type":"Answer","text":"Getting your barangay onboarded is simple: just fill out the Contact Form below and our team will reach out to you. We'll guide your barangay through the entire setup process, from configuring document types and staff accounts to training your team. The onboarding is completely free."}}]}2a:["$","script","3",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$63"}}]
